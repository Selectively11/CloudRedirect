<Page x:Class="CloudRedirect.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800">
            <TextBlock Text="{res:Loc Setup_Title}"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="DescriptionText"
                       Text="Deploy the CloudRedirect DLL alongside your compatible Steam unlock solution."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <ui:Button x:Name="RunAllButton"
                       Content="{res:Loc Setup_DeployDll}"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Appearance="Primary"
                       FontSize="14"
                       Padding="24,10"
                       HorizontalAlignment="Stretch"
                       Margin="0,0,0,4"
                       IsEnabled="False"
                       Click="RunAll_Click" />

            <TextBlock x:Name="DetectionStatusText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <TextBlock Text="{res:Loc Setup_LogOutput}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8" />

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,24"
                    MinHeight="200"
                    MaxHeight="400">
                <ScrollViewer x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogOutput"
                             FontFamily="Cascadia Code,Consolas,Courier New"
                             FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Text="{res:Loc Setup_Ready}" />
                </ScrollViewer>
            </Border>

            <!-- Diagnostics toggle -->
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{res:Loc Setup_ShowDiagnostics}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{res:Loc Setup_ShowDiagnosticsHint}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DiagnosticsToggle"
                                 Checked="DiagnosticsToggle_Click"
                                 Unchecked="DiagnosticsToggle_Click" />
            </ui:CardControl>

            <!-- Collapsible diagnostics panel -->
            <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">

                <ui:CardControl Margin="0,8,0,16">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Setup_SteamPath}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SteamPathText"
                                       Text="{res:Loc Setup_Detecting}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{res:Loc Setup_Change}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Click="BrowseSteamDir_Click" />
                </ui:CardControl>

                <TextBlock Text="{res:Loc Setup_DeployHeader}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{res:Loc Setup_DeployDescription}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Setup_DllStatus}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DeployStatusText"
                                       Text="{res:Loc Setup_NotChecked}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="24" />
                </ui:CardControl>

                <WrapPanel Margin="0,0,0,24">
                    <ui:Button x:Name="DeployButton"
                               Content="{res:Loc Setup_DeployDll}"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Appearance="Primary"
                               Margin="0,0,8,0"
                               Click="Deploy_Click" />
                    <ui:Button x:Name="UninstallDllButton"
                               Content="{res:Loc Setup_UninstallDll}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"
                               Click="UninstallDll_Click" />
                </WrapPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
